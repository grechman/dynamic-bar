#!/usr/bin/env python3
import json
import os
import sys

SETTINGS = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude")), "settings.json")
HOOK = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "hooks", "action-state.py")
EVENTS = ("SessionStart", "UserPromptSubmit", "PostToolUse", "PermissionRequest", "Notification", "Stop", "StopFailure", "SessionEnd")
MARK = "island"
USAGE = "island-claude-hook install | uninstall | status"


def load():
    try:
        with open(SETTINGS) as handle:
            return json.load(handle)
    except FileNotFoundError:
        return {}


def save(data):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    tmp = SETTINGS + ".tmp"
    with open(tmp, "w") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")
    os.replace(tmp, SETTINGS)


def is_ours(entry):
    return any(MARK in str(hook.get("command", "")) and "action-state.py" in str(hook.get("command", "")) for hook in entry.get("hooks", []))


def strip(data):
    hooks = data.get("hooks") or {}
    for event in list(hooks):
        kept = [entry for entry in hooks[event] if not is_ours(entry)]
        if kept:
            hooks[event] = kept
        else:
            hooks.pop(event)
    if hooks:
        data["hooks"] = hooks
    else:
        data.pop("hooks", None)


def install():
    data = load()
    strip(data)
    hooks = data.setdefault("hooks", {})
    for event in EVENTS:
        hooks.setdefault(event, []).append({"hooks": [{"type": "command", "command": f"python3 {HOOK}"}]})
    save(data)
    print(f"installed into {SETTINGS}")


def uninstall():
    data = load()
    strip(data)
    save(data)
    print(f"removed from {SETTINGS}")


def status():
    data = load()
    present = [event for event, entries in (data.get("hooks") or {}).items() if any(is_ours(e) for e in entries)]
    print("installed for: " + (", ".join(present) if present else "nothing"))


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "install":
        install()
    elif action == "uninstall":
        uninstall()
    elif action == "status":
        status()
    else:
        print(USAGE)
        sys.exit(1)


if __name__ == "__main__":
    main()
